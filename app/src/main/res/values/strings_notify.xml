<?xml version="1.0" encoding="utf-8"?>
<!-- 通知の文言。事実のみ。症状の予測・服薬の指示・助言はしない (FR-502, NFR-104)。 -->
<resources>
    <string name="notify_channel_effect_name">効果の入力</string>
    <string name="notify_channel_effect_desc">服薬の効果が未入力のときにお知らせします</string>
    <string name="notify_channel_drop_name">気圧の低下</string>
